{
  "manifest_version": 3,
  "name": "FDownloader - Facebook & YouTube Video Downloader",
  "version": "1.2.0",
  "description": "Tải video Facebook và YouTube với chất lượng cao nhất (tự ghép hình + tiếng).",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FDownloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["options.js", "ui.js", "facebook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["options.js", "mux.js", "ui.js", "youtube.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
